[Unit]
Description=Vision System Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Change this path if the repository is installed somewhere else.
WorkingDirectory=/opt/vision-system

# The install script rewrites User/Group to the account that ran it unless
# VISION_SERVICE_USER/VISION_SERVICE_GROUP are provided.
User=pi
Group=pi

Environment=PYTHONUNBUFFERED=1
Environment=VISION_MODEL_PROFILE=yellow_daifuku
Environment=VISION_CAMERA_INDEX=0
Environment=VISION_HOST=0.0.0.0
Environment=VISION_PORT=8000
Environment=VISION_IMGSZ=256
Environment=VISION_FRAME_WIDTH=424
Environment=VISION_FRAME_HEIGHT=240
Environment=VISION_INFERENCE_INTERVAL_MS=300
Environment=VISION_SNAPSHOT_INTERVAL_MS=1000

# Snapshot mode is intentionally off by default for production/HMI use.
# To enable debug snapshots, either add --enable-snapshot below or set:
# Environment=VISION_ENABLE_SNAPSHOT=true
#
# Bench simulation only:
# Environment=VISION_CAMERA_SOURCE=/opt/vision-system/samples/test.jpg
# Environment=VISION_DRY_RUN=true
ExecStart=/opt/vision-system/.venv/bin/python -m app.runtime.detector_service

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
