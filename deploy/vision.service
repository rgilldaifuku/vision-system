[Unit]
Description=Vision System Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vision-system
Environment=PYTHONUNBUFFERED=1
Environment=VISION_MODEL_PROFILE=mouse
Environment=VISION_CAMERA_INDEX=0
Environment=VISION_HOST=0.0.0.0
Environment=VISION_PORT=8000
ExecStart=/opt/vision-system/.venv/bin/python -m app.runtime.detector_service --profile ${VISION_MODEL_PROFILE} --camera ${VISION_CAMERA_INDEX} --host ${VISION_HOST} --port ${VISION_PORT}
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target

