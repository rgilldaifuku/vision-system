[Unit]
Description=Industrial AI Vision Runtime
After=network.target

[Service]
Type=simple

# Change these placeholders if the repository is installed somewhere else.
WorkingDirectory=/home/pi/vision-system

# The install script rewrites User/Group to the account that ran it unless
# VISION_SERVICE_USER/VISION_SERVICE_GROUP are provided.
User=pi
Group=pi

Environment=PYTHONUNBUFFERED=1

# Snapshot mode is intentionally off by default for production/HMI use.
# To enable debug snapshots, either add --enable-snapshot below or set:
# Environment=VISION_ENABLE_SNAPSHOT=true
#
# Bench simulation only:
# Environment=VISION_CAMERA_SOURCE=/home/pi/vision-system/samples/test.jpg
# Environment=VISION_DRY_RUN=true
ExecStart=/home/pi/vision-system/.venv/bin/python -m app.runtime.detector_service --profile yellow_daifuku --camera-backend picamera2 --host 0.0.0.0 --port 8000 --imgsz 256 --frame-width 640 --frame-height 480 --inference-interval-ms 300

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
